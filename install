#!/usr/bin/env bash
set -euo pipefail

readonly DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

show_help() {
  cat <<'EOF'
用法：
  ./install               完整安装或更新环境，并部署 dotfiles
  ./install --links-only  仅刷新 Dotbot 管理的配置
  ./install --help        显示帮助
EOF
}

case "${1:-}" in
  --links-only)
    shift
    exec bash "$DOTFILES_ROOT/install_scripts/run_dotbot.sh" "$@"
    ;;
  --help|-h)
    show_help
    ;;
  "")
    exec bash "$DOTFILES_ROOT/install_scripts/bootstrap_ubuntu24.sh"
    ;;
  *)
    printf '未知参数：%s\n' "$1" >&2
    show_help >&2
    exit 2
    ;;
esac
