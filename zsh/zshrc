# Load the default ROS 2 workspace for every interactive shell. Keep
# `ros2_on [workspace]` available for reloading or switching workspaces.
_dotfiles_ros2_setup_file() {
    local workspace="${1:-$HOME/ros2_ws}"

    if [[ -f "$workspace/install/setup.zsh" ]]; then
        REPLY="$workspace/install/setup.zsh"
    elif [[ -f /opt/ros/jazzy/setup.zsh ]]; then
        REPLY=/opt/ros/jazzy/setup.zsh
    else
        return 1
    fi
}

_dotfiles_ros2_completions() {
    local distro="${ROS_DISTRO:-}"
    [[ -n "$distro" ]] || return 0
    [[ "${_DOTFILES_ROS_COMPLETION_DISTRO:-}" == "$distro" ]] && return 0

    local ros2_completion="/opt/ros/$distro/share/ros2cli/environment/ros2-argcomplete.zsh"
    if [[ -r "$ros2_completion" ]]; then
        source "$ros2_completion"
    fi

    if command -v register-python-argcomplete >/dev/null 2>&1 \
        && command -v colcon >/dev/null 2>&1; then
        eval "$(register-python-argcomplete colcon)"
    fi

    typeset -g _DOTFILES_ROS_COMPLETION_DISTRO="$distro"
}

ros2_on() {
    local workspace="${1:-$HOME/ros2_ws}"
    if ! _dotfiles_ros2_setup_file "$workspace"; then
        print -u2 "未找到 ROS 2 Jazzy 或工作空间环境：$workspace"
        return 1
    fi

    source "$REPLY"
    _dotfiles_ros2_completions
    print "已加载 ROS 2 环境：$REPLY"
}

# Prefer the default workspace overlay and fall back to the Jazzy underlay.
# Stay silent when ROS 2 is not installed so the dotfiles remain portable.
if _dotfiles_ros2_setup_file "$HOME/ros2_ws"; then
    source "$REPLY"
    _dotfiles_ros2_completions
fi

autoload -Uz add-zsh-hook
add-zsh-hook precmd _dotfiles_ros2_completions

alias cw='cd ~/ros2_ws'
alias cs='cd ~/ros2_ws/src'
alias cm='cd ~/ros2_ws && colcon build --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON --symlink-install'
alias cmt='cd ~/ros2_test && colcon build --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON --symlink-install --allow-overriding project_bringup'
alias denv='source ~/dev_env/bin/activate'
export NVIM_PYTHON_VENV="$HOME/dev_env"
export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

export RCUTILS_CONSOLE_OUTPUT_FORMAT="[{severity}] [{time}]: {message}"

export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

