export LANG='en_US.UTF-8'
export LANGUAGE='en_US:en'
export LC_ALL='en_US.UTF-8'

# Keep command lookup deterministic and avoid duplicated PATH entries.
typeset -U path PATH
path=(${path:#/usr/include})
path=(${path:#/usr/include/})
path=(${path:#/usr/bin/})
path=(
    "$HOME/.local/bin"
    "$HOME/dev_env/bin"
    $path
)

##### Zsh/Oh-my-Zsh Configuration
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.local/share/oh-my-zsh/custom"

DISABLE_AUTO_UPDATE="true"
DISABLE_UPDATE_PROMPT="true"

# Starship owns the prompt; Oh My Zsh still provides plugins and shell helpers.
ZSH_THEME=""

# zsh-completions must extend fpath before Oh My Zsh runs compinit.
if [[ -d "$ZSH_CUSTOM/plugins/zsh-completions/src" ]]; then
    fpath=("$ZSH_CUSTOM/plugins/zsh-completions/src" $fpath)
fi

plugins=(
    git
    vi-mode
    fzf
    direnv
    fzf-tab
    zsh-autosuggestions
    # Keep this last: it must observe widgets registered by other plugins.
    zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

alias gs="git status"
alias s="tmux"
alias vim='nvim'

alias dkps="docker ps"
alias dkpa="docker ps -a"
alias dki="docker images"
alias dka="docker attach"
alias dkrm='docker rm'
alias dkrmi='docker rmi'

export MYZSHRC="$HOME/.zshrc"
export MYTMUXCONF="$HOME/.tmux.conf"

export VISUAL=nvim
export EDITOR=nvim

unsetopt nomatch

# for gfw
# Only enable the local proxy when it is actually running.
if command -v nc >/dev/null 2>&1 && nc -z 127.0.0.1 7890 >/dev/null 2>&1; then
    export http_proxy="http://127.0.0.1:7890"
    export https_proxy="http://127.0.0.1:7890"
else
    unset http_proxy
    unset https_proxy
fi

